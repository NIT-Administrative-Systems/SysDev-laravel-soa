{
    "name": "northwestern-sysdev/laravel-soa",
    "description": "Laravel bindings for popular Northwestern SOA services.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "northwestern",
        "northwestern university",
        "laravel"
    ],
    "authors": [
        {
            "name": "Nicholas Evans",
            "email": "nick.evans@northwestern.edu"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^7.0",
        "northwestern-sysdev/event-hub-php-sdk": "^3.0",
        "laravel/ui": "^4.0",
        "lcobucci/jwt": "^5.0",
        "lcobucci/clock": "^2|^3",
        "socialiteproviders/manager": "^4.8.1",
        "firebase/php-jwt": "^7",
        "laravel/prompts": "^0.3.10"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "php-coveralls/php-coveralls": "^2.4",
        "phpunit/phpunit": "^11.5.50|^12.0",
        "laravel/pint": "^1.13",
        "larastan/larastan": "^3.0",
        "spatie/invade": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Northwestern\\SysDev\\SOA\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Northwestern\\SysDev\\SOA\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Northwestern\\SysDev\\SOA\\Providers\\NuSoaServiceProvider"
            ]
        }
    }
}
